# Copy this file to `.env` (which is git-ignored per R2 / #94).
# Only VITE_-prefixed values may be read from the browser bundle.
# Non-VITE_ secrets (e.g. SUPABASE_SERVICE_ROLE_KEY) must NEVER appear
# here; they belong in the hosting provider's secret store.

VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-public-anon-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
